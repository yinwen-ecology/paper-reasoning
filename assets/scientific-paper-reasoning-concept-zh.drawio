        <mxCell id="18" value="主张 → 概念贡献：修正真正建立的新认识" edge="1" parent="1" source="9" target="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9a7c20;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#9a7c20;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;entryX=0.5;entryY=0;">
