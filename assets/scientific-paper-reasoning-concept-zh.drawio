          <mxGeometry x="50" y="730" width="800" height="285" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;明确展示元问题与回答&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=20;" vertex="1" parent="20">
          <mxGeometry x="18" y="14" width="764" height="28" as="geometry" />
        </mxCell>
        <mxCell id="22" value="&lt;b&gt;完整分析必须分别回答&lt;/b&gt;&lt;br&gt;元问题 1：真正的科学问题是什么？&lt;br&gt;元问题 2：为什么重要？&lt;br&gt;元问题 3：建立了什么新认识？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=19;" vertex="1" parent="20">
          <mxGeometry x="18" y="55" width="764" height="110" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;b&gt;元问题 4–8 按论文选择：&lt;/b&gt;判别证据、最强主张、科学故事、论证写法、可迁移经验。&lt;br&gt;&lt;b&gt;每个入选问题：&lt;/b&gt;显示完整问题与“回答：”，再展开证据及推理，让读者看懂为什么。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=17;" vertex="1" parent="20">
          <mxGeometry x="18" y="170" width="764" height="95" as="geometry" />
        </mxCell>
        <mxCell id="24" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="730" width="870" height="285" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;b&gt;六拍推理 · 检查五个逻辑连接&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=20;" vertex="1" parent="24">
          <mxGeometry x="18" y="14" width="834" height="28" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;b&gt;1　已有认识&lt;/b&gt; → &lt;b&gt;2　真正的张力&lt;/b&gt; → &lt;b&gt;3　研究方案&lt;/b&gt; →&lt;br&gt;&lt;br&gt;&lt;b&gt;4　决定性证据&lt;/b&gt; → &lt;b&gt;5　新认识&lt;/b&gt; → &lt;b&gt;6　科学后果&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=19;" vertex="1" parent="24">
          <mxGeometry x="18" y="60" width="834" height="100" as="geometry" />
        </mxCell>
        <mxCell id="27" value="充分展开前两拍：研究前已知道什么、证据处于什么尺度、认识在哪里接不上。再说明设计和证据如何改变判断。&lt;br&gt;&lt;b&gt;严格区分研究前的认识与论文结果揭示的新发现。&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=17;" vertex="1" parent="24">
          <mxGeometry x="18" y="170" width="834" height="95" as="geometry" />
        </mxCell>
        <mxCell id="28" value="&lt;b&gt;在 CODEX 中如何实现&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="50" y="1050" width="1700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="29" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;按需加载分析指导&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Skill 元信息 → SKILL.md → 科学推理框架与 Codex 执行指南。&lt;br&gt;&lt;br&gt;按需读取相关内容；长文任务保留证据笔记，便于持续分析。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="50" y="1100" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="30" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;用工具核验来源&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;读取本地材料或获取指定论文。查看关键图表与方法；新颖性判断需要时，核对相关前序研究。&lt;br&gt;&lt;br&gt;根据论文类型采用合适的证据标准。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="630" y="1100" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="31" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot;&gt;两次核验，交付可读分析&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;第一遍：主张、数值、分析单位与来源。&lt;br&gt;第二遍：术语、推断中间步骤与重复。&lt;br&gt;&lt;br&gt;保存可独立阅读的 UTF-8 Markdown：鲜明判断、元问题问答、六拍与研究原则。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1100" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="32" value="&lt;b&gt;质量标准&lt;/b&gt;　判断直接 · 主张匹配证据 · 讲清推断中间步骤 · 关键边界集中说明 · 连贯段落承载推理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=19;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="1315" width="1700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;font color=&quot;#666666&quot;&gt;●&lt;/font&gt; 来源／工具　&lt;font color=&quot;#6c8ebf&quot;&gt;●&lt;/font&gt; 问题／设计　&lt;font color=&quot;#d6b656&quot;&gt;●&lt;/font&gt; 证据／主张　&lt;font color=&quot;#9673a6&quot;&gt;●&lt;/font&gt; 推理叙事　&lt;font color=&quot;#82b366&quot;&gt;●&lt;/font&gt; 学习／交付　　&lt;b&gt;→&lt;/b&gt; 分析推进　　&lt;b&gt;⇢&lt;/b&gt; 反馈修正" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;spacing=0;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="1380" width="1700" height="30" as="geometry" />
        </mxCell>
      </root>
