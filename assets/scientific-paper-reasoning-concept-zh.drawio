  <diagram name="科研论文科学推理">
    <mxGraphModel dx="1800" dy="1430" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1430" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;科研论文科学推理&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=36;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1350" height="55" as="geometry" />
        </mxCell>
        <mxCell id="3" value="scientific-paper-reasoning Skill 概念图 · Codex / GPT-6.1 sol" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=19;spacing=0;fontColor=#607182;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="1350" height="35" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;目的&lt;/b&gt;　理解研究为什么必须走出下一步、证据改变了什么认识，并将这种推理能力用于自己的研究。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=23;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="1700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;从论文证据出发&lt;/b&gt;　阅读全文、图表与图注、关键方法；必要时查阅补充材料。&lt;br&gt;保留简洁的证据记录：&lt;b&gt;主张 → 关键结果 → 来源位置&lt;/b&gt;。只有摘要时，给出现有材料支持的初步分析。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="230" width="1700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;1　定位问题与张力&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;明确科学问题及其重要性。梳理研究前已有的认识、尚未解决的张力，以及拟建立的概念贡献。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;2　检验可回答性&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;检查概念如何对应测量，以及变异、尺度、不同预测和可辨识性。&lt;br&gt;&lt;b&gt;这个设计实际能回答什么？&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="338" y="410" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;3　建立证据架构&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;寻找决定性比较或最小必要证据组合，比较合理的替代解释。&lt;br&gt;&lt;b&gt;去掉哪项结果，主张会明显削弱？&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="626" y="410" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;4　校准核心主张&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;直接说出证据支持的最强结论。让相关、预测、机制与因果的表述匹配研究设计。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="914" y="410" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;5　重建推理与叙事&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;重建六拍与五个逻辑连接，解释为什么必须做下一步。检查图表和文字是否服务同一个问题。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1202" y="410" width="260" height="240" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;&lt;font style=&quot;font-size:21px&quot;&gt;6　提炼可迁移原则&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;提炼 3–7 条可用于其他研究的原则。指出下一个有判别力的问题，以及新认识带来的后果。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243444;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1490" y="410" width="260" height="240" as="geometry" />
        </mxCell>
